msgid "目標圧力"
msgstr "Target Pressure"

#: ../../cu_lattice/reproduction.rst:174
msgid "0 GPa"
msgstr "0 GPa"

#: ../../cu_lattice/reproduction.rst:176
msgid "最適化最大ステップ数"
msgstr "Max Optimization Steps"

#: ../../cu_lattice/reproduction.rst:177
msgid "100"
