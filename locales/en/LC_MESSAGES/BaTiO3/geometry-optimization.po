#: ../../BaTiO3/geometry-optimization.rst:192
msgid "CHGNet：固定格子・z方向のみの原子座標緩和"
msgstr "CHGNet: Fixed-Lattice Relaxation of Atomic Coordinates Along z Only"

#: ../../BaTiO3/geometry-optimization.rst:194
msgid "以下は、CHGNet の入力例です。\\ 正方晶の面内原子配置を保持するため、x 方向および y 方向の力をゼロにし、z 方向のみを緩和します。"
msgstr ""
"The following is the CHGNet input example. \\  To preserve the tetragonal"
" in-plane atomic arrangement, the input sets the forces along x and y to "
"zero and allows relaxation only along z."

#: ../../BaTiO3/geometry-optimization.rst:203
msgid ""
"# 固定格子・正方晶強誘電 BaTiO3 の CHGNet 構造最適化\n"
"# 格子定数と格子角は固定する\n"
"# 正方晶 P4mm 的な面内原子配置を保持する\n"
"# c 軸方向の強誘電変位のみを緩和する\n"
"\n"
"units metal\n"
"boundary p p p\n"
"atom_style atomic\n"
"\n"
"read_data QuloudJob.lmp\n"
"\n"
"pair_style chgnet ../../../../../../../../CHGNET\n"
"pair_coeff * * 0.3.0 Ba Ti O\n"
"\n"
"neighbor 2.0 bin\n"
"neigh_modify every 1 delay 0 check yes\n"
"\n"
"thermo_style custom step pe etotal temp vol press pxx pyy pzz fmax\n"
"thermo 10\n"
"\n"
"dump 1 all custom 5 QuloudJob.lammpstrj id type x y z fx fy fz\n"
"dump_modify 1 sort id\n"
"\n"
"# x 方向および y 方向の力をゼロにし、z 方向のみを緩和する\n"
"fix keep_tet all setforce 0.0 0.0 NULL\n"
"\n"
"min_style fire\n"
"minimize 1.0e-15 1.0e-7 1000 10000\n"
"\n"
"unfix keep_tet\n"
"\n"
"write_data QuloudJob.out.lmp\n"
"write_dump all custom QuloudJob.final.lammpstrj id type x y z fx fy fz"
msgstr ""
"# CHGNet geometry optimization of tetragonal ferroelectric BaTiO3 at a "
"fixed lattice\n"
"# Keep the lattice constants and angles fixed\n"
"# Preserve the tetragonal P4mm-like in-plane atomic arrangement\n"
"# Relax only the ferroelectric displacements along the c axis\n"
"\n"
"units metal\n"
"boundary p p p\n"
"atom_style atomic\n"
"\n"
"read_data QuloudJob.lmp\n"
"\n"
"pair_style chgnet ../../../../../../../../CHGNET\n"
"pair_coeff * * 0.3.0 Ba Ti O\n"
"\n"
"neighbor 2.0 bin\n"
"neigh_modify every 1 delay 0 check yes\n"
"\n"
"thermo_style custom step pe etotal temp vol press pxx pyy pzz fmax\n"
"thermo 10\n"
"\n"
"dump 1 all custom 5 QuloudJob.lammpstrj id type x y z fx fy fz\n"
"dump_modify 1 sort id\n"
"\n"
"# Set forces along x and y to zero and allow relaxation only along z\n"
"fix keep_tet all setforce 0.0 0.0 NULL\n"
"\n"
"min_style fire\n"
"minimize 1.0e-15 1.0e-7 1000 10000\n"
"\n"
"unfix keep_tet\n"
"\n"
"write_data QuloudJob.out.lmp\n"
"write_dump all custom QuloudJob.final.lammpstrj id type x y z fx fy fz"

