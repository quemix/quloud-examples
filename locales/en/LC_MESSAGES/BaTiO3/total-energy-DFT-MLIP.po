"# File Name\n"
"#\n"
"\n"
"System.CurrrentDirectory ./\n"
"System.Name BTO_cubic_PE_Nomd\n"
"DATA.PATH /usr/local/rsdft/DFT_DATA19\n"
"\n"
"#\n"
"# Definition of Atomic Species\n"
"#\n"
"\n"
"Species.Number 3\n"
"<Definition.of.Atomic.Species\n"
