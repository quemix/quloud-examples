"Atoms.SpeciesAndCoordinates.Unit Ang\n"
"<Atoms.SpeciesAndCoordinates\n"
"1 Ba  0.0   0.0   0.0   5.0  5.0\n"
"2 Ti  2.01  2.01  2.09  6.0  6.0\n"
"3 O   2.01  2.01  0.0   3.0  3.0\n"
"4 O   2.01  0.0   2.01  3.0  3.0\n"
